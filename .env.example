NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Required in production (the server refuses to start requests
# without it); route handlers use it and enforce membership themselves.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI assistant (server-only)
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-5
# Tokens per user per UTC day (default 300000; 0 disables the assistant)
AGENT_DAILY_TOKEN_LIMIT=300000
# Model for "Analizar con Claude" and locating map places (default claude-sonnet-5-5)
IDEAS_MODEL=

# Video analysis of ideas (server-only). Without GEMINI_API_KEY it is off.
# Use a key with billing enabled: the free tier allows ~20 videos a day.
GEMINI_API_KEY=
VIDEO_MODEL=gemini-3.8-flash
# Used when the main model is overloaded; "none" disables it
VIDEO_FALLBACK_MODEL=gemini-3.5-flash
# Analyses per user per UTC day (default 30) and longest video in seconds (default 300)
VIDEO_DAILY_LIMIT=30
VIDEO_MAX_SECONDS=300
# "on" when GEMINI_API_KEY is set: new ideas show "Viendo el video…"
NEXT_PUBLIC_VIDEO_ANALYSIS=
# Instagram reels: Apify token and actor that read the post (server-only).
# Without a token, members are asked to upload the video instead.
INSTAGRAM_PROVIDER_TOKEN=
INSTAGRAM_PROVIDER_ACTOR=apify~instagram-scraper

# "on" pauses all trip writes (503, clients retry) during the cut-over window
MAINTENANCE_MODE=

# Public origin for Open Graph and the sitemap (defaults to the Vercel production domain)
NEXT_PUBLIC_SITE_URL=

# Server-only. Signs the assistant's paused proposals (approve/reject); required in production
AGENT_RESUME_SECRET=

# Optional. Public URL of the demo video shown on the landing page (#demo); the section is hidden when empty
NEXT_PUBLIC_DEMO_VIDEO_URL=
